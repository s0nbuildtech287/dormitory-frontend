@startuml "Disciplinary Create Sequence"
skinparam defaultFontSize 22
skinparam defaultFontName "Times New Roman"
skinparam sequenceMessageSize 22
actor "Ban quản lý" as Admin
participant "Giao diện" as FE
participant "DisciplinaryController" as DC
participant "DisciplinaryService" as DS
database "CSDL" as DB

Admin -> FE: Nhập phiếu kỷ luật
FE -> DC: POST /api/disciplinary
DC -> DS: create(args)
DS -> DB: INSERT disciplinary_records
DB --> DS: OK
DC --> FE: 201 Created
@enduml
