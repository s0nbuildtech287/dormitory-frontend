@startuml "Asset Management Sequence"
skinparam defaultFontSize 22
skinparam defaultFontName "Times New Roman"
skinparam sequenceMessageSize 22
actor "Ban quản lý" as Admin
participant "Giao diện" as FE
participant "AssetController" as AC
participant "AssetService" as AS
database "CSDL" as DB

Admin -> FE: Thêm/Sửa/Xóa tài sản
FE -> AC: POST|PUT|DELETE /api/assets
AC -> AS: create|update|delete
AS -> DB: INSERT/UPDATE/DELETE assets
DB --> AS: OK
AC --> FE: 200 OK

Admin -> FE: Điều chỉnh giới hạn tài sản
FE -> AC: PUT /api/assets/limits
AC -> AS: updateAssetLimit(args)
AS -> DB: UPDATE asset_limits
DB --> AS: OK
AC --> FE: 200 OK
@enduml
