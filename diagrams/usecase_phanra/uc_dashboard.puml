@startuml "UC Phân rã - Dashboard & Thống kê"
skinparam defaultFontSize 22
skinparam defaultFontName "Times New Roman"
left to right direction
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam actor {
  BackgroundColor White
  BorderColor Black
}
skinparam ArrowColor Black
skinparam ArrowThickness 1
skinparam shadowing false

actor "<b>Ban quản lý</b>" as Admin

usecase "<b>Xem tổng quan hệ thống</b>" as UC1
usecase "<b>Xem thống kê hồ sơ đăng ký</b>" as UC2
usecase "<b>Xem thống kê mật độ phòng</b>" as UC3
usecase "<b>Xem thống kê hợp đồng</b>" as UC4
usecase "<b>Xem thống kê hóa đơn & doanh thu</b>" as UC5
usecase "<b>Xem thống kê phản ánh</b>" as UC6
usecase "<b>Xem thống kê tài sản</b>" as UC7
usecase "<b>Xem lịch sử hoạt động (log)</b>" as UC8

Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4
Admin --> UC5
Admin --> UC6
Admin --> UC7
Admin --> UC8
@enduml
