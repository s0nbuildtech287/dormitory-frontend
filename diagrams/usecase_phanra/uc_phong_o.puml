@startuml "UC Phân rã - Quản lý phòng ở"
skinparam defaultFontSize 22
skinparam defaultFontName "Times New Roman"
left to right direction
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam actor {
  BackgroundColor White
  BorderColor Black
}
skinparam ArrowColor Black
skinparam ArrowThickness 1
skinparam shadowing false

actor "<b>Ban quản lý</b>" as Admin

usecase "<b>Xem danh sách phòng</b>" as UC1
usecase "<b>Thêm phòng</b>" as UC2
usecase "<b>Sửa thông tin phòng</b>" as UC3
usecase "<b>Xóa phòng</b>" as UC4
usecase "<b>Cập nhật chỉ số điện/nước</b>" as UC5
usecase "<b>Xem thống kê mật độ phòng</b>" as UC6

Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4
Admin --> UC5
Admin --> UC6
@enduml
