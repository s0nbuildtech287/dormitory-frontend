@startuml "UC Phân rã - Quản lý hóa đơn"
skinparam defaultFontSize 18
skinparam defaultFontName "Times New Roman"
left to right direction
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam actor {
  BackgroundColor White
  BorderColor Black
}
skinparam ArrowColor Black
skinparam ArrowThickness 1
skinparam shadowing false

actor "<b>Ban quản lý</b>" as Admin

usecase "<b>Xem danh sách hóa đơn</b>" as UC1
usecase "<b>Xem chi tiết hóa đơn</b>" as UC2
usecase "<b>Tạo hóa đơn theo phòng</b>" as UC3
usecase "<b>Cập nhật hóa đơn</b>" as UC4
usecase "<b>Xác nhận thanh toán thủ công</b>" as UC5
usecase "<b>Xóa hóa đơn</b>" as UC6
usecase "<b>Phát hiện bất thường điện/nước</b>" as UC7
usecase "<b>Tự động cập nhật hóa đơn quá hạn</b>" as UC8
usecase "<b>Điều chỉnh bảng giá dịch vụ</b>" as UC9
usecase "<b>Gửi nhắc nhở thanh toán qua email</b>" as UC10
usecase "<b>Xem thống kê doanh thu</b>" as UC11

Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC4
Admin --> UC5
Admin --> UC6
Admin --> UC7
Admin --> UC8
Admin --> UC9
Admin --> UC10
Admin --> UC11
@enduml
