@startuml "UC Phân rã - Quản lý xung kích"
skinparam defaultFontSize 22
skinparam defaultFontName "Times New Roman"
left to right direction
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}
skinparam actor {
  BackgroundColor White
  BorderColor Black
}

actor "Quản lý tòa nhà" as Admin

usecase "Thiết lập phòng xung kích" as UC1
usecase "Chuyển SV vào phòng xung kích" as UC2
usecase "Bổ nhiệm/Miễn nhiệm SV xung kích" as UC3

Admin --> UC1
Admin --> UC2
Admin --> UC3
@enduml
