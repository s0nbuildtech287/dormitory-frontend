@startuml "Contract Create Assign Sequence"
actor "Ban quản lý" as Admin
participant "Giao diện" as FE
participant "ContractController" as CC
participant "ContractService" as CS
participant "RoomDAO" as RoomDAO
participant "StudentContractDAO" as SCDAO
database "CSDL" as DB

Admin -> FE: Tạo hợp đồng từ hồ sơ
FE -> CC: POST /api/contracts/from-registration
CC -> CS: createFromRegistration(registrationId, roomId, data)
CS -> SCDAO: create contract (Pending)
SCDAO -> DB: INSERT student_contracts
DB --> SCDAO: OK
CC --> FE: 201 Created

Admin -> FE: Gán phòng
FE -> CC: POST /api/contracts/{id}/assign-room
CC -> CS: assignRoom(contractId, roomId)
CS -> RoomDAO: check availability
RoomDAO -> DB: SELECT room
DB --> RoomDAO: OK
CS -> SCDAO: update contract (Active)
SCDAO -> DB: UPDATE student_contracts
DB --> SCDAO: OK
CC --> FE: 200 OK
@enduml
