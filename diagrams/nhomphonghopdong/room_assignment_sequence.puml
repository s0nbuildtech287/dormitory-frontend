@startuml "Room Assignment Sequence"
skinparam defaultFontSize 26
skinparam defaultFontName "Times New Roman"
skinparam sequenceMessageSize 26
actor "Ban quản lý" as Admin
participant "Giao diện" as FE
participant "RoomAssignmentController" as RAC
participant "RoomAssignmentService" as RAS
participant "RoomDAO" as RoomDAO
participant "StudentContractDAO" as SCDAO
database "CSDL" as DB

Admin -> FE: Yêu cầu gợi ý phòng
FE -> RAC: POST /api/room-assignments/suggestions
RAC -> RAS: getSuggestions(args)
RAS -> RoomDAO: findAvailableRooms(args)
RoomDAO -> DB: SELECT rooms
DB --> RoomDAO: room list
RAS -> SCDAO: getStudentContract(args)
SCDAO -> DB: SELECT student_contracts
DB --> SCDAO: contract info
RAS --> RAC: suggestions
RAC --> FE: 200 OK (list suggestions)

Admin -> FE: Chọn phòng để gán
FE -> RAC: POST /api/room-assignments/assign
RAC -> RAS: assignRoom(args)
RAS -> RoomDAO: check availability
RoomDAO -> DB: SELECT room
DB --> RoomDAO: OK
RAS -> SCDAO: update contract (Active)
SCDAO -> DB: UPDATE student_contracts
DB --> SCDAO: OK
RAS -> RoomDAO: update occupancy
RoomDAO -> DB: UPDATE rooms
DB --> RoomDAO: OK
RAC --> FE: 200 OK
@enduml
