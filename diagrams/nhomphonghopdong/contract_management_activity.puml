@startuml "Contract Management Activity"
skinparam defaultFontSize 22
skinparam defaultFontName "Times New Roman"
|Ban quản lý|
start
:Chọn quản lý hợp đồng;
:Hiển thị danh sách hợp đồng;
if (Thao tác?) then (Tạo hợp đồng)
  :Chọn hồ sơ đã duyệt;
  :Tích chọn tiền cọc;
  :Xác nhận bản cứng đã gửi;
  |Hệ thống|
  :Tạo hợp đồng trạng thái Pending;
  |Ban quản lý|
  :Gợi ý gán phòng;
  :Gửi mail thông báo tới sinh viên;
else (Chấm dứt hợp đồng)
  :Chọn hợp đồng cần chấm dứt;
  :Nhập lý do (nếu có);
  |Hệ thống|
  :Kiểm tra trạng thái hợp đồng;
  :Chuyển trạng thái = Terminated;
  |Ban quản lý|
  :Hoàn tất chấm dứt;
endif
stop
@enduml
