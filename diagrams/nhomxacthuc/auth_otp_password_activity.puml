@startuml "Auth OTP Password Activity"
skinparam defaultFontSize 22
skinparam defaultFontName "Times New Roman"
' Activity Diagram: OTP + Xác thực + Đổi mật khẩu
|Người dùng|
start
:Chọn "Quên mật khẩu";
|Hệ thống|
:Hiển thị form nhập email;
|Người dùng|
:Nhập email;
:Nhấn Gửi OTP;
|Hệ thống|
:Kiểm tra email tồn tại;
if (Email hợp lệ?) then (Có)
  :Tạo OTP;
  :Gửi OTP qua Email;
  |Người dùng|
  :Nhập OTP + mật khẩu mới;
  :Nhấn Xác nhận;
  |Hệ thống|
  :Xác thực OTP;
  if (OTP đúng?) then (Đúng)
    :Băm mật khẩu mới;
    :Cập nhật mật khẩu;
    |Người dùng|
    :Thông báo thành công;
    stop
  else (Sai)
    :Thông báo OTP sai/hết hạn;
    |Người dùng|
    :Nhập lại OTP;
    stop
  endif
else (Không)
  :Thông báo email không tồn tại;
  |Người dùng|
  :Nhập lại email;
  stop
endif
@enduml
