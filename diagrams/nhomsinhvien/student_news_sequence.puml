@startuml "Student News Sequence"
skinparam defaultFontSize 20
skinparam defaultFontName "Times New Roman"
skinparam sequenceMessageSize 20

actor "Sinh viên" as Student
participant "Giao diện" as FE
participant "Hệ thống\nBackend" as BE
participant "Trang tin\n(TLU)" as TLU
participant "Hệ thống AI\n(Gemini)" as Gemini

== 1. Xem danh sách tin tức ==
Student -> FE: 1. Truy cập trang tin tức
FE -> BE: 2. Yêu cầu danh sách tin
alt Tin lưu tạm còn hạn
  BE -> BE: 3. Đọc dữ liệu từ bộ nhớ đệm
else Hết hạn lưu tạm
  BE -> TLU: 4. Lấy dữ liệu từ web trường
  TLU --> BE: 5. Trả về nội dung tin tức
  BE -> BE: 6. Trích xuất tin và lưu tạm
end
BE --> FE: 7. Gửi danh sách tin tức
FE --> Student: 8. Hiển thị danh sách tin tức

== 2. AI phân tích & hỏi đáp ==
Student -> FE: 9. Chọn bài viết và yêu cầu AI tóm tắt
FE -> BE: 10. Yêu cầu phân tích bài viết
BE -> TLU: 11. Lấy chi tiết nội dung từ nguồn
TLU --> BE: 12. Trả về nội dung bài viết
BE -> Gemini: 13. Gửi văn bản yêu cầu phân tích
Gemini --> BE: 14. Trả về kết quả phân tích
BE --> FE: 15. Gửi nội dung tóm tắt
FE --> Student: 16. Hiển thị tóm tắt AI

opt Sinh viên hỏi thêm
  Student -> FE: 17. Nhập câu hỏi về bài viết
  FE -> BE: 18. Gửi câu hỏi kèm ngữ cảnh
  BE -> Gemini: 19. Yêu cầu AI trả lời câu hỏi
  Gemini --> BE: 20. Trả về câu trả lời
  BE --> FE: 21. Gửi lại câu trả lời
  FE --> Student: 22. Hiển thị câu trả lời AI
end
@enduml
