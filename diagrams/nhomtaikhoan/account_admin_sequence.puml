@startuml "Admin Account Management Sequence"
skinparam defaultFontSize 28
skinparam defaultFontName "Times New Roman"
skinparam sequenceMessageSize 28
actor "Ban quản lý" as Admin
participant "Giao diện" as FE
participant "AuthController" as AuthC
participant "AuthService" as AuthS
participant "UserController" as UserC
participant "UserService" as UserS
database "CSDL" as DB

== Quản lý tài khoản ==
Admin -> FE: Mở mục Quản lý tài khoản

alt Xem/Cập nhật/Đổi mật khẩu
	FE -> UserC: GET /api/users/me
	UserC -> UserS: getProfile(args)
	UserS -> DB: SELECT users
	DB --> UserS: Dữ liệu
	UserS --> UserC: Thông tin
	UserC --> FE: 200 OK
	Admin -> FE: Cập nhật thông tin hoặc đổi mật khẩu
	alt Cập nhật thông tin cá nhân
		FE -> UserC: PUT /api/users/me
		UserC -> UserS: updateProfile(args)
		UserS -> DB: UPDATE users
		DB --> UserS: OK
		UserC --> FE: 200 OK
	else Đổi mật khẩu
		FE -> AuthC: PUT /api/auth/change-password
		AuthC -> AuthS: changePassword(args)
		AuthS -> DB: SELECT + UPDATE users
		DB --> AuthS: OK
		AuthC --> FE: 200 OK
	end
else Tạo admin mới
	Admin -> FE: Tạo admin mới
	FE -> AuthC: POST /api/admins
	AuthC -> AuthS: checkRole(ADMIN)
	AuthS -> DB: SELECT role FROM users
	DB --> AuthS: ROLE=ADMIN
	alt Người thao tác là quản trị viên
		AuthS -> UserC: createAdmin(args)
		UserC -> UserS: createAdmin(args)
		UserS -> DB: INSERT users (role = ADMIN)
		DB --> UserS: OK
		UserS --> UserC: Tài khoản admin mới
		UserC --> AuthC: 201 Created
		AuthC --> FE: 201 Created
	else Không đủ quyền
		AuthS --> AuthC: 403 Forbidden
		AuthC --> FE: 403 Forbidden
	end
end

== Bật/tắt OTP ==
Admin -> FE: Bật/tắt OTP
FE -> AuthC: PUT /api/auth/otp
AuthC -> AuthS: toggleOtp(args)
AuthS -> DB: UPDATE users
DB --> AuthS: OK
AuthC --> FE: 200 OK
@enduml
