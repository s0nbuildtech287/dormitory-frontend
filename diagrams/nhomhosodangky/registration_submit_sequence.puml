@startuml "Registration Submit Sequence"
skinparam defaultFontSize 20
skinparam defaultFontName "Times New Roman"
skinparam sequenceMessageSize 20

actor "Sinh viên" as Student
participant "Giao diện" as FE
participant "Hệ thống\nBackend" as BE
database "CSDL" as DB

Student -> FE: 1. Nhập thông tin và tải lên minh chứng
FE -> BE: 2. Gửi yêu cầu đăng ký hồ sơ
BE -> BE: 3. Kiểm tra tính hợp lệ dữ liệu

alt Hồ sơ hợp lệ
  BE -> DB: 4. Lưu thông tin hồ sơ (trạng thái Chờ duyệt)
  DB --> BE: 5. Xác nhận lưu thành công
  BE --> FE: 6. Trả về kết quả đăng ký thành công
  FE --> Student: 7. Hiển thị thông báo đăng ký hoàn tất
else Hồ sơ không hợp lệ
  BE --> FE: 8. Trả về thông báo lỗi chi tiết
  FE --> Student: 9. Hiển thị lỗi yêu cầu sửa lại
end
@enduml
