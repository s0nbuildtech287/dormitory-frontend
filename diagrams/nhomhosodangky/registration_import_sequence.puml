@startuml "Registration Import Sequence"
skinparam defaultFontSize 22
skinparam defaultFontName "Times New Roman"
skinparam sequenceMessageSize 22
actor "Ban quản lý" as Admin
participant "Giao diện" as FE
participant "RegistrationController" as RegC
participant "RegistrationService" as RegS
participant "VisionService" as VisionS
participant "RegisterFormDAO" as RegDAO
database "CSDL" as DB

alt Import Excel / Google Sheets
  Admin -> FE: Chọn file Excel hoặc dán link Google Sheets
  FE -> RegC: POST /api/registrations/import
  RegC -> RegS: importRegistrations(data)
  RegS -> RegDAO: bulkInsertTemp(records)
  RegDAO -> DB: INSERT register_forms (tạm thời)
  DB --> RegDAO: OK
  
  loop Từng hồ sơ vừa import
    RegS -> RegS: Tính điểm ưu tiên & điểm xét tuyển
    opt Có ảnh minh chứng diện chính sách
      RegS -> VisionS: validateEvidenceImage(imageUrl)
      VisionS --> RegS: Kết quả text OCR / độ khớp minh chứng
    end
    RegS -> RegDAO: updateScoresAndSuggestion(id, score, suggestion)
    RegDAO -> DB: UPDATE register_forms
  end
  
  RegS --> RegC: Kết quả import (số lượng, đề xuất duyệt)
  RegC --> FE: 200 OK (Import & Xử lý thành công)
  FE --> Admin: Hiển thị danh sách hồ sơ kèm điểm và gợi ý xét duyệt
end
@enduml
