@startuml "Registration Import Sequence"
skinparam defaultFontSize 22
skinparam defaultFontName "Times New Roman"
skinparam sequenceMessageSize 22
actor "Ban quản lý" as Admin
participant "Giao diện" as FE
participant "RegistrationController" as RegC
participant "RegistrationService" as RegS
participant "GoogleSheetsService" as GSS
participant "RegisterFormDAO" as RegDAO
database "CSDL" as DB

alt Import Excel
  Admin -> FE: Chọn file Excel
  FE -> RegC: POST /api/registrations/import/excel
  RegC -> RegS: importFromExcel(args)
  RegS -> RegDAO: bulkCreate(records)
  RegDAO -> DB: INSERT registrations
  DB --> RegDAO: OK
  RegS --> RegC: Kết quả
  RegC --> FE: 200 OK
else Import Google Sheets
  Admin -> FE: Dán URL Google Sheets
  FE -> RegC: POST /api/registrations/import/sheets
  RegC -> RegS: importFromGoogleSheets(args)
  RegS -> GSS: readSheet(url)
  GSS --> RegS: rows
  RegS -> RegDAO: bulkCreate(rows)
  RegDAO -> DB: INSERT registrations
  DB --> RegDAO: OK
  RegS --> RegC: Kết quả
  RegC --> FE: 200 OK
end
@enduml
