@startuml "Registration Review Activity"
|Ban quản lý|
start
:Chọn hồ sơ cần duyệt;
:Nhập ghi chú (nếu cần);
if (Duyệt?) then (Có)
  |Hệ thống|
  :Cập nhật trạng thái = APPROVED;
  :Tạo tài khoản sinh viên
  (email = email SV,
  mật khẩu = CCCD);
  :Gửi thông báo kết quả;
  |Ban quản lý|
  :Hoàn tất duyệt;
else (Từ chối)
  |Hệ thống|
  :Cập nhật trạng thái = REJECTED;
  :Gửi thông báo lý do;
  |Ban quản lý|
  :Hoàn tất từ chối;
endif
if (Điều chỉnh trọng số?) then (Có)
  |Ban quản lý|
  :Cập nhật trọng số;
  |Hệ thống|
  :Tính lại điểm toàn bộ hồ sơ;
endif
|Ban quản lý|
:Hoàn tất;
stop
@enduml
