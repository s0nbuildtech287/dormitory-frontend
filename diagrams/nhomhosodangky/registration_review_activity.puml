@startuml "Registration Review Activity"
skinparam defaultFontSize 22
skinparam defaultFontName "Times New Roman"
|Quản lý tòa nhà|
start
if (Chọn chế độ duyệt?) then (Thủ công)
  :Chọn hồ sơ cụ thể;
  if (Duyệt?) then (Duyệt)
    |Hệ thống|
    :Phê duyệt, tạo tài khoản SV\n& hợp đồng Pending;
    :Gửi email kết quả;
  else (Từ chối)
    |Hệ thống|
    :Từ chối hồ sơ\n& gửi email lý do;
  endif
else (Tự động theo lô)
  |Quản lý tòa nhà|
  :Kích hoạt Duyệt tự động;
  |Hệ thống|
  :Xác định Khoa/Ngành áp dụng;
  :Sắp xếp hồ sơ theo nhóm\nvà điểm xét tuyển giảm dần;
  while (Còn chỉ tiêu\n& danh sách hồ sơ?) is (Có)
    :Duyệt hồ sơ & khởi tạo\ntài khoản, hợp đồng;
  endwhile (Không)
  :Hiển thị báo cáo kết quả\nduyệt hàng loạt;
endif
|Quản lý tòa nhà|
stop
@enduml
