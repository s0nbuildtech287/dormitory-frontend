@startuml "Registration Review Sequence"
skinparam defaultFontSize 20
skinparam defaultFontName "Times New Roman"
skinparam sequenceMessageSize 20

actor "Quản lý tòa nhà" as Admin
participant "Giao diện" as FE
participant "Hệ thống\nBackend" as BE
database "CSDL" as DB

alt Chế độ 1: Duyệt thủ công
  Admin -> FE: Chọn hồ sơ & ghi chú duyệt/từ chối
  FE -> BE: Yêu cầu duyệt hoặc từ chối
  BE -> DB: Cập nhật trạng thái hồ sơ
  opt Trường hợp duyệt thành công
    BE -> DB: Tạo tài khoản & hợp đồng mới
  end
  BE -> DB: Lưu thông tin thông báo
  BE --> FE: Kết quả xử lý đơn
  FE --> Admin: Hiển thị trạng thái mới

else Chế độ 2: Duyệt tự động hàng loạt
  Admin -> FE: Thiết lập chỉ tiêu & chạy duyệt
  FE -> BE: Gửi yêu cầu duyệt tự động
  BE -> DB: Lấy cài đặt chỉ tiêu & đơn chờ
  BE -> BE: Sắp xếp hồ sơ & phân bổ chỉ tiêu
  
  opt Chạy duyệt thật (không mô phỏng)
    BE -> DB: Cập nhật đơn, tạo tài khoản & hợp đồng
    opt Có chỉ tiêu tạm thời
      BE -> DB: Lưu cấu hình chỉ tiêu mới
    end
  end
  
  BE --> FE: Kết quả phân bổ (mô phỏng hoặc thật)
  FE --> Admin: Hiển thị báo cáo & nút xác nhận duyệt
end
@enduml
