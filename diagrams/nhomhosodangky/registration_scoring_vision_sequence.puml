@startuml "Registration Scoring Vision Sequence"
participant "RegistrationService" as RegS
participant "RegisterFormDAO" as RegDAO
participant "ImageValidatorService" as VisionS
database "CSDL" as DB

== Tính điểm hồ sơ ==
RegS -> RegS: calcScore(data)
RegS -> RegDAO: create(registration)
RegDAO -> DB: INSERT register_forms
DB --> RegDAO: OK

== Xác thực ảnh (admin kích hoạt) ==
actor "Ban quản lý" as Admin
participant "RegistrationController" as RegC
Admin -> RegC: POST /api/registrations/{id}/validate-images
RegC -> RegDAO: update(vision_status=PENDING)
RegDAO -> DB: UPDATE register_forms
DB --> RegDAO: OK
RegC -> VisionS: validateRegistrationImages(id)
VisionS --> RegC: result
RegC --> Admin: Kết quả xác thực
@enduml
