@startuml "Registration Scoring Vision Activity"
skinparam defaultFontSize 22
skinparam defaultFontName "Times New Roman"
|Hệ thống|
start
:Nhận hồ sơ mới;
:Tính điểm theo trọng số;
:Đặt trạng thái hồ sơ = PENDING;
|Ban quản lý|
:Chọn xác thực ảnh (Vision API);
|Hệ thống|
:Reset vision_status = PENDING;
:Chạy Vision API;
if (Ảnh hợp lệ?) then (Có)
  :Cập nhật vision_status = APPROVED;
else (Không)
  :Cập nhật vision_status = REJECTED;
endif
|Ban quản lý|
:Nhận kết quả xác thực;
stop
@enduml
