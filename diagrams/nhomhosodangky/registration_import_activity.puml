@startuml "Registration Import Activity"
skinparam defaultFontSize 22
skinparam defaultFontName "Times New Roman"
skinparam swimlaneWidth same

|Ban quản lý tòa nhà|
start
:Chọn Import hồ sơ;
:Chọn Excel hoặc\nGoogle Sheets;
|Hệ thống|
:Nhận file hoặc URL;
if (Nguồn hợp lệ?) then (Có)
  :Đọc dữ liệu và\nvalidate thông tin;
  :Lưu hồ sơ tạm vào CSDL;
  :Tính toán điểm xét tuyển,\nđiểm ưu tiên & phân loại nhóm\n(Nhóm 1, 2, 3);
  :Lưu điểm xét duyệt\n& đề xuất vào CSDL;
  :Kích hoạt xác thực ảnh\nminh chứng nền (Vision API);
  |Ban quản lý tòa nhà|
  :Thông báo nhập hồ sơ\nvà xử lý điểm thành công;
  stop
else (Không)
  |Hệ thống|
  :Thông báo lỗi\nđịnh dạng/URL;
  |Ban quản lý tòa nhà|
  :Sửa nguồn và thử lại;
  stop
endif
@enduml
